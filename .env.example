# ---------- Database (local Postgres via docker-compose, or Supabase Postgres) ----------
POSTGRES_USER=jobhunter
# REQUIRED: choose a strong password. Keep it identical in DATABASE_URL below.
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jobhunter
# The backend runs on your machine and reaches the docker-compose database on
# localhost (Phase 9 moves the backend into compose).
DATABASE_URL=postgresql+asyncpg://jobhunter:change_me@localhost:5432/jobhunter

# ---------- File storage (uploaded resumes) ----------
# local: files under LOCAL_STORAGE_DIR (default). supabase: private Supabase bucket
# (run supabase/storage.sql once to create it).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=job-hunter

# ---------- Claude API ----------
# Optional. Without a key, parsing and profiles are rule-based (no AI enrichment).
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SCORING=claude-haiku-5-5
CLAUDE_MODEL_WRITING=claude-sonnet-5-5
# Resume-parse fallback, profile inference, career analysis, skill extraction.
CLAUDE_MODEL_ANALYSIS=claude-opus-5-5
CLAUDE_EFFORT_ANALYSIS=low       # low | medium | high | xhigh | max
CLAUDE_MAX_RETRIES=3
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_REFUSAL_FALLBACK=true     # retry a declined request on a fallback model
# Job scoring with Claude: off until enabled on the Settings page. These caps
# bound the cost: jobs per run, real API calls per rolling 24 hours, pacing.
CLAUDE_EFFORT_SCORING=low
CLAUDE_SCORING_MAX_PER_RUN=25
CLAUDE_SCORING_MAX_PER_DAY=100
CLAUDE_SCORING_PER_MINUTE=10
LLM_CACHE_TTL_DAYS=30            # cached Claude answers; 0 = keep forever
AGENT_RUN_RETENTION_DAYS=180     # run log kept this long (pruned daily)

# ---------- Resume uploads ----------
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20
PARSE_TIMEOUT_SECONDS=30         # per file, in an isolated process
PARSE_MEMORY_LIMIT_MB=1024
# Antivirus: none | clamd (ClamAV daemon). Uploads are always structurally checked.
VIRUS_SCANNER=none
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# ---------- App ----------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
# LOG_JSON=true                # default: JSON logs in production only
DOCS_ENABLED=true              # Swagger UI at /api/v1/docs
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # comma-separated
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Auth (single user) ----------
# none:    no credentials; only allowed while BACKEND_HOST is loopback.
# api_key: send X-API-Key or "Authorization: Bearer"; needed for any other host.
AUTH_MODE=none
# API_KEY=                     # >= 32 chars, e.g. `openssl rand -hex 32`

# ---------- Scheduler / background work ----------
# In-process: run the backend with a single worker.
SCHEDULER_ENABLED=true
# Re-filter and re-score jobs in the background when settings or the profile change.
RESCORE_ON_CHANGE=true

# ---------- Automation ----------
PLAYWRIGHT_HEADLESS=true
BROWSER_STATE_DIR=/app/browser_state

# ---------- Job discovery (Greenhouse, Lever, Ashby public boards) ----------
# Scheduled refresh interval; each run only re-crawls companies that are due.
DISCOVERY_INTERVAL_MINUTES=360
# Boards crawled in parallel (1-16), per-request timeout and attempts (with backoff).
DISCOVERY_CONCURRENCY=4
CONNECTOR_TIMEOUT_SECONDS=30
CONNECTOR_RETRY_ATTEMPTS=4
